-- Zad1 B
SELECT SDO_TUNE.ESTIMATE_RTREE_INDEX_SIZE(3000000, 8192, 10, 2, 0) FROM DUAL;

-- Zad1 C
CREATE INDEX figury_idx ON figury(ksztalt) INDEXTYPE IS MDSYS.SPATIAL_INDEX_V2;

-- Zad1 D
SELECT ID FROM FIGURY
WHERE SDO_FILTER(ksztalt, MDSYS.SDO_GEOMETRY(2001, NULL, MDSYS.SDO_POINT_TYPE(3,3,NULL), NULL, NULL)) = 'TRUE';

-- Zad1 E
SELECT ID FROM FIGURY
WHERE SDO_RELATE(ksztalt, MDSYS.SDO_GEOMETRY(2001, NULL, MDSYS.SDO_POINT_TYPE(3,3,NULL), NULL, NULL), 'mask=ANYINTERACT') = 'TRUE';

-- Zad2 A
SELECT c.CITY_NAME MIASTO, SDO_NN_DISTANCE(1) ODL
FROM MAJOR_CITIES c
WHERE SDO_NN(c.GEOM, (SELECT geom FROM MAJOR_CITIES WHERE city_name = 'Warsaw'), 'sdo_num_res=10 unit=km', 1) = 'TRUE'
AND c.CITY_NAME <> 'Warsaw';

-- Zad2 B
SELECT c.CITY_NAME MIASTO
FROM MAJOR_CITIES c
WHERE SDO_WITHIN_DISTANCE(c.GEOM, (SELECT geom FROM MAJOR_CITIES WHERE city_name = 'Warsaw'), 'distance=100 unit=km') = 'TRUE'
AND c.CITY_NAME <> 'Warsaw';

-- Zad2 C
SELECT b.CNTRY_NAME KRAJ, c.CITY_NAME MIASTO
FROM MAJOR_CITIES c, COUNTRY_BOUNDARIES b
WHERE b.CNTRY_NAME = 'Slovakia'
AND SDO_RELATE(c.GEOM, b.GEOM, 'mask=INSIDE') = 'TRUE';

-- Zad2 D
SELECT b2.CNTRY_NAME PANSTWO, SDO_GEOM.SDO_DISTANCE(b1.GEOM, b2.GEOM, 1, 'unit=km') ODL
FROM COUNTRY_BOUNDARIES b1, COUNTRY_BOUNDARIES b2
WHERE b1.CNTRY_NAME = 'Poland'
AND b2.CNTRY_NAME <> 'Poland'
AND SDO_RELATE(b2.GEOM, b1.GEOM, 'mask=ANYINTERACT') <> 'TRUE';

-- Zad3 A
SELECT b2.CNTRY_NAME, SDO_GEOM.SDO_LENGTH(SDO_GEOM.SDO_INTERSECTION(b1.GEOM, b2.GEOM, 1), 1, 'unit=km') ODLEGLOSC
FROM COUNTRY_BOUNDARIES b1, COUNTRY_BOUNDARIES b2
WHERE b1.CNTRY_NAME = 'Poland'
AND SDO_RELATE(b2.GEOM, b1.GEOM, 'mask=TOUCH') = 'TRUE';

-- Zad3 B
SELECT CNTRY_NAME
FROM COUNTRY_BOUNDARIES
ORDER BY SDO_GEOM.SDO_AREA(GEOM, 1, 'unit=SQ_KM') DESC
FETCH FIRST 1 ROWS ONLY;

-- Zad3 C
SELECT SDO_GEOM.SDO_AREA(SDO_GEOM.SDO_MBR(SDO_GEOM.SDO_UNION(c1.GEOM, c2.GEOM, 1)), 1, 'unit=SQ_KM') SQ_KM
FROM MAJOR_CITIES c1, MAJOR_CITIES c2
WHERE c1.CITY_NAME = 'Warsaw' AND c2.CITY_NAME = 'Lodz';

-- Zad3 D
SELECT SDO_GEOM.SDO_UNION(b.GEOM, c.GEOM, 1).GET_GTYPE() GTYPE
FROM COUNTRY_BOUNDARIES b, MAJOR_CITIES c
WHERE b.CNTRY_NAME = 'Poland' AND c.CITY_NAME = 'Prague';

-- Zad3 E
SELECT c.CITY_NAME, b.CNTRY_NAME
FROM MAJOR_CITIES c, COUNTRY_BOUNDARIES b
WHERE SDO_RELATE(c.GEOM, b.GEOM, 'mask=INSIDE') = 'TRUE'
ORDER BY SDO_GEOM.SDO_DISTANCE(c.GEOM, SDO_GEOM.SDO_CENTROID(b.GEOM, 1), 1) ASC
FETCH FIRST 1 ROWS ONLY;

-- Zad3 F
SELECT r.NAME, SUM(SDO_GEOM.SDO_LENGTH(SDO_GEOM.SDO_INTERSECTION(r.GEOM, b.GEOM, 1), 1, 'unit=km')) DLUGOSC
FROM RIVERS r
CROSS JOIN COUNTRY_BOUNDARIES b
WHERE b.CNTRY_NAME = 'Poland'
AND SDO_RELATE(r.GEOM, b.GEOM, 'mask=ANYINTERACT') = 'TRUE'
GROUP BY r.NAME;
